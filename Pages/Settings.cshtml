@page "/settings"
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

@if (Model.Message is not null)
{
    <p class="notice">@Model.Message</p>
}
@if (Model.Error is not null)
{
    <p class="notice error">@Model.Error</p>
}

<div class="stack">
    <section class="panel">
        <h2>This instance</h2>
        <p class="muted">
            Logged in as <strong>@Model.Username</strong> · @Model.BookmarkCount
            @(Model.BookmarkCount == 1 ? "bookmark" : "bookmarks") ·
            AI tagging @(Model.TaggingEnabled ? "enabled" : "disabled") ·
            <a href="@Model.ExportUrl">download backup</a>
        </p>
    </section>

    <section class="panel">
        <h2>Bookmarklet</h2>
        <p class="muted">
            Drag this onto your bookmarks toolbar. Clicking it on any page then opens the add form,
            prefilled — with any text you have selected as the description.
        </p>
        <p>
            @* A real javascript: link, so it can be dragged straight to the toolbar. *@
            <a class="bookmarklet" href="@Model.Bookmarklet" draggable="true"
               title="Drag me to your bookmarks toolbar">+ @Model.SiteTitle</a>
        </p>
        <details>
            <summary class="muted">Can't drag it? Copy the code instead</summary>
            <textarea class="snippet" data-copy readonly onclick="this.select()">@Model.Bookmarklet</textarea>
        </details>
    </section>

    <section class="panel">
        <h2>iOS Shortcut</h2>
        <p class="muted">
            A minute in the Shortcuts app and any page can be saved with <em>Share → your
            shortcut</em>. It sends the page address and nothing else — the title, description and
            tags are filled in here. Sharing a page you already saved hands back the bookmark you
            have rather than making a second one.
        </p>

        <ol class="steps">
            <li>
                Shortcuts app → <strong>+</strong> → open the shortcut's <strong>ⓘ</strong> →
                turn on <strong>Show in Share Sheet</strong>.
            </li>
            <li>
                Under the accepted types, leave <strong>Safari web pages</strong> <em>and</em>
                <strong>URLs</strong> ticked. Safari shares a <em>web page</em>, not a bare URL —
                a shortcut accepting only URLs never appears in Safari's share sheet.
            </li>
            <li>
                <strong>Add Action</strong> → search <strong>Get URLs from Input</strong>, tap it.
                It should read <em>Get URLs from</em> <strong>Shortcut Input</strong>. This step is
                what reliably turns the shared page into its address — the raw
                <em>Shortcut Input</em> chip can hand over the page's <em>title</em> instead, and
                the save fails.
            </li>
            <li><strong>Add Action</strong> → search <strong>Get Contents of URL</strong>, tap it.</li>
            <li>Paste the address below into its <strong>URL</strong> field.</li>
            <li>
                Leave the cursor at the very end and tap <strong>URLs</strong> in the bar above the
                keyboard — the output of step 3 — so the field ends with <code>&amp;url=</code>
                followed by a blue chip.
            </li>
            <li>Name it — that name is what you'll tap in the Share Sheet.</li>
        </ol>

        <p class="muted">
            Step 5 — your address and token are already in it. It ends at <code>&amp;url=</code>
            on purpose; the blue chip from step 6 is what completes it.
        </p>
        <textarea class="snippet" data-copy readonly onclick="this.select()">@Model.ShortcutUrl</textarea>

        <details>
            <summary class="muted">What the finished shortcut looks like</summary>
            <img class="screenshot" src="/ios-shortcut.jpeg"
                 alt="The finished shortcut: Receive Safari Web Pages and URLs from Share Sheet, then Get Contents of URL with the address ending in url= followed by a blue chip." />
            <p class="muted">
                The screenshot predates step 3 — yours will also have a
                <em>Get URLs from Input</em> action above <em>Get contents of URL</em>, and a
                <strong>URLs</strong> chip after <code>&amp;url=</code> instead of
                <em>Shortcut Input</em>.
            </p>
        </details>

        <h3>Optional: a “Saved” banner</h3>
        <p class="muted">
            On its own the shortcut finishes silently. Two more actions turn the server's reply
            into a notification — <em>Saved: the page's title</em>, <em>Already saved</em> when you
            had it, or the error when something went wrong.
        </p>
        <ol class="steps">
            <li>
                <strong>Add Action</strong> → search <strong>Get Dictionary Value</strong>, tap it,
                and type <code>message</code> as the key.
            </li>
            <li>
                <strong>Add Action</strong> → search <strong>Show Notification</strong>, tap into
                its text, and tap <strong>Dictionary Value</strong> in the bar above the keyboard.
            </li>
        </ol>

        <h3>Optional: ask for tags</h3>
        <p class="muted">
            Adds a small prompt on every save. Type a few comma-separated tags — or just tap
            <strong>Done</strong>: left empty, tags are filled in here as usual.
        </p>
        <ol class="steps">
            <li>
                <strong>Add Action</strong> → search <strong>Ask for Input</strong>, tap it, set
                its prompt to <em>Tags</em> — then drag it <strong>above</strong> Get Contents of
                URL.
            </li>
            <li>
                In the address, place the cursor just <em>before</em> <code>&amp;url=</code>, type
                <code>&amp;tags=</code>, and tap <strong>Provided Input</strong> in the bar above
                the keyboard. Keep <code>&amp;url=</code> last — links that carry their own query
                string depend on it.
            </li>
        </ol>
    </section>

    <section class="panel">
        <h2>API token</h2>
        <p class="token" data-copy>@Model.ApiToken</p>
        <p class="muted">
            Also accepted as an <code>Authorization: Token …</code> header. Generating a new one
            takes effect immediately and breaks every bookmarklet and shortcut until you update them.
            Your password is not affected.
        </p>
        <form method="post" asp-page-handler="Token" class="actions">
            <button type="submit" onclick="return confirm('Generate a new API token? The current one stops working immediately.');">
                Generate new token
            </button>
        </form>
    </section>

    <section class="panel">
        <h2>Change password</h2>
        <form method="post" asp-page-handler="Password">
            <div class="field">
                <label asp-for="CurrentPassword">Current password</label>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
            </div>
            <div class="field">
                <label asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" />
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Repeat new password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            </div>
            <div class="actions">
                <button type="submit" class="primary">Change password</button>
            </div>
        </form>
    </section>
</div>

<script>
    (function () {
        // The buttons are built here rather than written into the markup: with scripting off there
        // is no clipboard at all, and a dead button is worse than the tap-to-select fallback the
        // snippets already have.
        document.querySelectorAll('[data-copy]').forEach(function (target) {
            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'linkish copy';
            button.textContent = 'Copy';

            button.addEventListener('click', function () {
                var text = 'value' in target ? target.value : (target.textContent || '').trim();
                copy(text)
                    .then(function () { flash(button, 'Copied'); })
                    .catch(function () { flash(button, 'Select it and copy'); });
            });

            target.insertAdjacentElement('afterend', button);
        });

        function copy(text) {
            // navigator.clipboard only exists in a secure context, and this app is meant to run over
            // plain http on a LAN — so the selection route below is the usual path here, not the
            // exception. Don't delete it in favour of the modern API alone.
            if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);

            var scratch = document.createElement('textarea');
            scratch.value = text;
            scratch.setAttribute('readonly', '');
            scratch.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0';
            document.body.appendChild(scratch);

            // iOS Safari won't select a plain readonly textarea, and wants a range as well as a
            // selection range before it will copy anything.
            scratch.contentEditable = 'true';
            scratch.readOnly = false;
            var range = document.createRange();
            range.selectNodeContents(scratch);
            var selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            scratch.setSelectionRange(0, text.length);

            var copied = document.execCommand('copy');
            document.body.removeChild(scratch);
            return copied ? Promise.resolve() : Promise.reject();
        }

        function flash(button, message) {
            button.textContent = message;
            setTimeout(function () { button.textContent = 'Copy'; }, 1500);
        }
    })();
</script>
