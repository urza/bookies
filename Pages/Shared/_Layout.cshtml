@inject IOptions<AppOptions> AppOptions
@{
    var siteTitle = AppOptions.Value.Title;
    var signedIn = User.Identity?.IsAuthenticated == true;

    // The bookmarklet window is one form and nothing else: no header, no search, no navigation —
    // there is nowhere to navigate to from a window you're about to close. Add and Edit set this.
    var popup = ViewData["Popup"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is null ? siteTitle : $"{ViewData["Title"]} · {siteTitle}")</title>

    @* SVG first — it follows the browser's light/dark theme; the .ico is for the browsers that
       ignore SVG icons, and is declared rather than left to the default /favicon.ico request so
       they don't have to guess. *@
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="alternate icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />

    <link rel="stylesheet" href="~/style.css" asp-append-version="true" />
</head>
<body class="@(popup ? "popup" : null)">
@if (!popup)
{
    <header>
        <div class="bar">
            @* The favicon's own geometry, inline so it costs no request and needs no second copy of
               the amber — the tile is where style.css's --accent comes from. *@
            <a class="brand" asp-page="/Index">
                <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
                    <rect width="32" height="32" rx="7" fill="#f0b429" />
                    <path d="M12 6h8a2 2 0 0 1 2 2v18l-6-8-6 8V8a2 2 0 0 1 2-2z" fill="#1b1c1a" />
                </svg>@siteTitle
            </a>

            <form class="search" asp-page="/Index" method="get" role="search">
                <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Search…" aria-label="Search bookmarks" />
            </form>

            <nav>
                @if (signedIn)
                {
                    <a class="add" asp-page="/Add">Add</a>
                    <a asp-page="/Settings">Settings</a>
                    <form asp-page="/Logout" method="post" class="inline">
                        <button type="submit" class="linkish">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Login">Log in</a>
                }
            </nav>
        </div>
    </header>
}

<main>
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)

<script>
    (function () {
        var form = document.querySelector('form.search');
        if (!form) return;

        var input = form.querySelector('input[name="q"]');
        var submitted = input.value.trim();
        var timer;

        function search(delay) {
            clearTimeout(timer);
            timer = setTimeout(function () {
                if (input.value.trim() === submitted) return;
                form.submit();
            }, delay);
        }

        input.addEventListener('input', function () {
            var value = input.value.trim();
            // Emptying the box should feel instant; one or two characters aren't worth a round trip.
            if (value.length === 0) search(0);
            else if (value.length < 3) clearTimeout(timer);
            else search(500);
        });

        // Fired by the browser's own clear (×) button, and by Enter.
        input.addEventListener('search', function () { search(0); });
    })();

    // One place decides who owns the caret on load. An [autofocus] field — only the inline edit
    // form sets one — always beats the search box, which otherwise gets it back so that returning
    // from a search just continues typing. The attribute alone can't do this: it drops the caret in
    // front of the existing text, and browsers abandon it if anything touches focus first.
    (function () {
        var edit = document.querySelector('[autofocus]');
        var search = document.querySelector('form.search input[name="q"]');
        // A q in the query string means you arrived here from the search box, so the caret belongs
        // back in it. Test for the key, not for a value: clearing the box submits an empty q, and
        // that reload has to hand the caret back too or backspacing to nothing loses your place.
        // A plain visit or a tag link has no q at all, and must not steal focus.
        var searching = search && new URLSearchParams(location.search).has('q');
        var target = edit || (searching ? search : null);
        if (!target) return;
        // Something already grabbed focus for itself — leave it alone.
        if (document.activeElement !== document.body && document.activeElement !== target) return;

        target.focus();
        // End of the text, so you keep typing rather than typing in front of it. Only these types
        // support a selection range; url/email/number throw InvalidStateError.
        if (target.tagName === 'TEXTAREA' || target.type === 'search' || target.type === 'text') {
            target.setSelectionRange(target.value.length, target.value.length);
        }
    })();
</script>

@if (popup)
{
    <script>
        // Grow the popup until the form fits. The bookmarklet can only ask for a fixed pixel size,
        // but the window inherits the opener's zoom level, so at 150% the same form needs half again
        // as much room and the buttons end up below the fold. A window opened by script is allowed
        // to resize itself, so measure what's actually overflowing and ask for exactly that.
        //
        // Measure in CSS pixels (scrollHeight, innerHeight) but resize in the window's own units
        // (outerHeight), which zoom does not scale — hence the ratio, and hence the retry: each
        // resize reflows the page, so the next pass sees what the last one missed.
        (function () {
            if (!window.opener || !window.resizeTo) return;

            function fit(pass) {
                var zoom = window.innerWidth ? window.outerWidth / window.innerWidth : 1;
                var width = Math.min(Math.round(window.outerWidth + (700 - window.innerWidth) * zoom), screen.availWidth);
                if (pass === 0 && width > window.outerWidth) window.resizeTo(width, window.outerHeight);

                var over = document.documentElement.scrollHeight - window.innerHeight;
                if (over > 2) {
                    var height = Math.min(Math.round(window.outerHeight + over * zoom), screen.availHeight - 40);
                    if (height > window.outerHeight) window.resizeTo(window.outerWidth, height);
                }

                // Four passes is plenty to converge, and stops dead if it can't.
                if (pass < 3) requestAnimationFrame(function () { fit(pass + 1); });
            }

            window.addEventListener('load', function () { fit(0); });
        })();
    </script>
}
</body>
</html>
